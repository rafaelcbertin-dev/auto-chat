{
  "name": "autochat",
  "version": "0.1.0",
  "private": true,
  "description": "Automação de DMs e comentários do Instagram e WhatsApp (uso próprio), rodando em Cloudflare Workers + D1.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply autochat --remote",
    "db:migrate:local": "wrangler d1 migrations apply autochat --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
